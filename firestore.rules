rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /campTurnerRoles/{roleId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'name',
          'roleTitle',
          'claimedByUid',
          'claimedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.roleTitle is string
        && request.resource.data.claimedByUid == request.auth.uid;

      allow delete: if request.auth != null
        && resource.data.claimedByUid == request.auth.uid;

      allow update: if false;
    }

    match /campTurnerPlayers/{playerUid} {
      allow read: if request.auth != null
        && request.auth.uid == playerUid;

      allow create, update: if request.auth != null
        && request.auth.uid == playerUid
        && request.resource.data.keys().hasOnly([
          'playerName',
          'attendanceStatus',
          'anonymousUid',
          'confirmedAt',
          'updatedAt',
          'roleId',
          'roleTitle',
          'claimedAt',
          'scareViewedAt',
          'roleReleasedAt'
        ])
        && request.resource.data.playerName is string
        && request.resource.data.playerName.size() > 0
        && request.resource.data.playerName.size() <= 40
        && request.resource.data.attendanceStatus == 'confirmed'
        && request.resource.data.anonymousUid == request.auth.uid;

      allow delete: if false;
    }
  }
}
