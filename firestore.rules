rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /campTurnerAssignments/{roleId} {
      allow read: if true;

      // Simple one-shot setup:
      // Anyone with the private invitation URL can create or update a role.
      // Existing roles cannot be overwritten by a different counselor name.
      allow create: if request.resource.data.playerName is string
                    && request.resource.data.playerName.size() > 0;

      allow update: if resource.data.playerName == request.resource.data.playerName;

      allow delete: if true;
    }
  }
}
